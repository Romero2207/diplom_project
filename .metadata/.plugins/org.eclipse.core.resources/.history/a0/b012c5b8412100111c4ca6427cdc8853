/* USER CODE BEGIN 4 */
void BWM427_ReadAngles(void)
{
    // 1. Формируем запрос Modbus RTU
    // Запрос: [Адрес устройства] [Функция] [Адрес регистра] [Кол-во регистров] [CRC]
    tx_buffer[0] = 0x01;        // Адрес устройства = 1
    tx_buffer[1] = 0x03;        // Функция 03 = Read Holding Registers (чтение регистров)
    tx_buffer[2] = 0x00;        // Адрес регистра (старший байт) = 0x0000
    tx_buffer[3] = 0x00;        // Адрес регистра (младший байт)
    tx_buffer[4] = 0x00;        // Количество регистров (старший байт) = 0x0002
    tx_buffer[5] = 0x02;        // Количество регистров (младший байт) = читаем 2 регистра

    // CRC пока оставляем 0 (рассчитаем позже)
    tx_buffer[6] = 0x00;        // CRC старший байт
    tx_buffer[7] = 0x00;        // CRC младший байт

    // 2. Включаем передачу на RS485 (PA8 = HIGH)
    // Модуль MAX485 начинает передавать данные от STM32 к датчику
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_SET);

    // 3. Отправляем запрос через UART1
    // &huart1 — это наш UART (создан CubeIDE)
    // tx_buffer — данные для отправки
    // 8 — количество байт
    // 100 — таймаут (100 мс)
    HAL_UART_Transmit(&huart1, tx_buffer, 8, 100);

    // 4. Небольшая задержка
    // Даём датчику время на подготовку ответа
    HAL_Delay(10);

    // 5. Включаем приём на RS485 (PA8 = LOW)
    // Модуль MAX485 начинает принимать данные от датчика к STM32
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_RESET);

    // 6. Принимаем ответ от датчика
    // Ожидаем 9 байт: [Адрес][Функция][Длина][Данные X][Данные Y][CRC]
    HAL_UART_Receive(&huart1, rx_buffer, 9, 100);

    // 7. Разбираем ответ
    // По документации: данные приходят как 2 байта на каждый угол
    // raw_x = (старший байт << 8) | младший байт
    raw_x = (int16_t)((rx_buffer[3] << 8) | rx_buffer[4]);
    raw_y = (int16_t)((rx_buffer[5] << 8) | rx_buffer[6]);

    // 8. Преобразуем в градусы
    // По документации: 1 единица = 0.01 градуса
    // Пример: raw_x = 1250 → angle_x = 12.50°
    angle_x = (float)raw_x * 0.01f;
    angle_y = (float)raw_y * 0.01f;

    // 9. Устанавливаем флаг: данные готовы
    modbus_ready = 1;
}

