// ========== Функция расчёта CRC16 для Modbus RTU ==========
uint16_t CRC16_Modbus(uint8_t *data, uint8_t length)
{
    uint16_t crc = 0xFFFF;
    for (uint8_t i = 0; i < length; i++) {
        crc ^= data[i];
        for (uint8_t j = 0; j < 8; j++) {
            if (crc & 0x0001) { crc >>= 1; crc ^= 0xA001; }
            else { crc >>= 1; }
        }
    }
    return crc;
}

// ========== Опрос датчика BWM427 ==========
void BWM427_ReadAngles(void)
{
    tx_buffer[0] = 0x01;  // Адрес устройства
    tx_buffer[1] = 0x03;  // Функция чтения регистров
    tx_buffer[2] = 0x00;  // Адрес регистра (старший)
    tx_buffer[3] = 0x00;  // Адрес регистра (младший)
    tx_buffer[4] = 0x00;  // Количество регистров (старший)
    tx_buffer[5] = 0x02;  // Количество регистров (младший) = 2 регистра

    // Рассчитываем CRC
    uint16_t crc = CRC16_Modbus(tx_buffer, 6);
    tx_buffer[6] = crc & 0xFF;        // Младший байт CRC
    tx_buffer[7] = (crc >> 8) & 0xFF; // Старший байт CRC

    // Передача на RS485
    HAL_GPIO_WritePin(RS485_DE_PORT, RS485_DE_PIN, GPIO_PIN_SET);
    HAL_GPIO_WritePin(RS485_RE_PORT, RS485_RE_PIN, GPIO_PIN_SET);
    HAL_UART_Transmit(&huart1, tx_buffer, 8, 100);
    HAL_Delay(10);

    // Приём с RS485
    HAL_GPIO_WritePin(RS485_DE_PORT, RS485_DE_PIN, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(RS485_RE_PORT, RS485_RE_PIN, GPIO_PIN_RESET);
    HAL_UART_Receive(&huart1, rx_buffer, 9, 100);

    // Разбор ответа
    raw_x = (int16_t)((rx_buffer[3] << 8) | rx_buffer[4]);
    raw_y = (int16_t)((rx_buffer[5] << 8) | rx_buffer[6]);

    // Конвертация в градусы
    angle_x = (float)raw_x * 0.01f;
    angle_y = (float)raw_y * 0.01f;

    modbus_ready = 1;
}

