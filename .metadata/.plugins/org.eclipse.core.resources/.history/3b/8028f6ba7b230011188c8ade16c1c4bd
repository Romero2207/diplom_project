// Получить пиксель символа из шрифта
static uint8_t GetFontPixel(char c, uint8_t x, uint8_t y) {
    if (c < '0' || c > '9') return 0;  // Только цифры 0-9
    return (Font5x7[c - '0'][x] >> y) & 0x01;
}

// Вывод одного символа (цифры, знак +/−, точка)
static void TFT_DrawChar(char c, uint16_t x, uint16_t y, uint16_t color, uint16_t bg) {
    // Спецсимволы для углов
    if (c == '+' || c == '-' || c == '.') {
        // Простая отрисовка спецсимволов
        if (c == '.') {
            TFT_SetAddrWindow(x, y+6, x, y+6);
            TFT_DC_Data();
            TFT_Data16(color);
        }
        return;
    }

    // Цифры 0-9
    if (c >= '0' && c <= '9') {
        for (uint8_t i = 0; i < 5; i++) {
            for (uint8_t j = 0; j < 7; j++) {
                if (GetFontPixel(c, i, j)) {
                    TFT_SetAddrWindow(x + i, y + j, x + i, y + j);
                    TFT_DC_Data();
                    TFT_Data16(color);
                }
            }
        }
    }
}

// Вывод строки текста (только цифры, +, -, .)
void TFT_PrintText(const char* str, uint16_t x, uint16_t y, uint16_t color, uint16_t bg) {
    while (*str) {
        TFT_DrawChar(*str++, x, y, color, bg);
        x += 6;  // 5 пикселей ширина + 1 пробел
    }
}

// Вывод угла с автоматическим выбором цвета (ТОЛЬКО ЧИСЛА)
void TFT_PrintAngle(float value, uint16_t x, uint16_t y, uint16_t base_color) {
    // Выбираем цвет по значению угла
    uint16_t color = GREEN;
    if (value > 10.0f || value < -10.0f) color = RED;
    else if (value > 5.0f || value < -5.0f) color = YELLOW;

    char buf[16];
    // СТАЛО (вариант без sprintf):
    int16_t int_value = (int16_t)(value * 100);  // Умножаем на 100
    int16_t whole = int_value / 100;              // Целая часть
    int16_t frac = abs(int_value % 100);          // Дробная часть

    // Формируем строку вручную
    buf[0] = (whole < 0) ? '-' : '+';
    whole = abs(whole);
    buf[1] = '0' + (whole / 10);
    buf[2] = '0' + (whole % 10);
    buf[3] = '.';
    buf[4] = '0' + (frac / 10);
    buf[5] = '0' + (frac % 10);
    buf[6] = '\0';
    TFT_PrintText(buf, x, y, color, BLACK);
}

// === Управление дисплеем ===
static void TFT_DC_Cmd(void)  { HAL_GPIO_WritePin(TFT_DC_PORT, TFT_DC_PIN, GPIO_PIN_RESET); }
static void TFT_DC_Data(void) { HAL_GPIO_WritePin(TFT_DC_PORT, TFT_DC_PIN, GPIO_PIN_SET); }

// Отправка команды
static void TFT_Cmd(uint8_t cmd) {
    TFT_DC_Cmd();
    HAL_SPI_Transmit(&hspi1, &cmd, 1, 100);
}

// Отправка данных (1 байт)
static void TFT_Data8(uint8_t data) {
    TFT_DC_Data();
    HAL_SPI_Transmit(&hspi1, &data, 1, 100);
}

// Отправка данных (2 байта)
static void TFT_Data16(uint16_t data) {
    TFT_DC_Data();
    uint8_t buf[2] = { (data >> 8) & 0xFF, data & 0xFF };
    HAL_SPI_Transmit(&hspi1, buf, 2, 100);
}

// Сброс дисплея
static void TFT_Reset(void) {
    HAL_GPIO_WritePin(TFT_RES_PORT, TFT_RES_PIN, GPIO_PIN_RESET);
    HAL_Delay(10);
    HAL_GPIO_WritePin(TFT_RES_PORT, TFT_RES_PIN, GPIO_PIN_SET);
    HAL_Delay(120);
}

// Установка области рисования
static void TFT_SetAddrWindow(uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1) {
    TFT_Cmd(0x2A);
    TFT_Data16(x0); TFT_Data16(x1);
    TFT_Cmd(0x2B);
    TFT_Data16(y0); TFT_Data16(y1);
    TFT_Cmd(0x2C);
}

// Закрасить экран цветом
void TFT_FillScreen(uint16_t color) {
    TFT_SetAddrWindow(0, 0, 239, 239);
    TFT_DC_Data();
    for (int i = 0; i < 240 * 240; i++) {
        TFT_Data16(color);
    }
}

// Инициализация ST7789 (240x240) — ИСПРАВЛЕННАЯ
void TFT_Init(void) {
    __HAL_RCC_GPIOB_CLK_ENABLE();
    GPIO_InitTypeDef GPIO_InitStruct = {0};
    GPIO_InitStruct.Pin = TFT_DC_PIN | TFT_RES_PIN;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(TFT_DC_PORT, &GPIO_InitStruct);

    TFT_Reset();
    HAL_Delay(120);

    // Базовые команды
    TFT_Cmd(0x11); HAL_Delay(120);           // SLPOUT
    TFT_Cmd(0x3A); TFT_Data8(0x05);          // COLMOD: 16-bit

    // ОРИЕНТАЦИЯ — КРИТИЧНО! (0x60 = MX=1 для 240×240)
    TFT_Cmd(0x36); TFT_Data8(0x60);

    // Настройки для 240×240
    TFT_Cmd(0xB2); TFT_Data8(0x0C); TFT_Data8(0x0C); TFT_Data8(0x00); TFT_Data8(0x33); TFT_Data8(0x33);
    TFT_Cmd(0xB7); TFT_Data8(0x35);
    TFT_Cmd(0xBB); TFT_Data8(0x19);
    TFT_Cmd(0xC0); TFT_Data8(0x2C);
    TFT_Cmd(0xC2); TFT_Data8(0x01);
    TFT_Cmd(0xC3); TFT_Data8(0x12);
    TFT_Cmd(0xC4); TFT_Data8(0x20);
    TFT_Cmd(0xC6); TFT_Data8(0x0F);
    TFT_Cmd(0xD0); TFT_Data8(0xA4); TFT_Data8(0xA1);

    // Гамма
    uint8_t gp[] = {0xD0,0x04,0x0D,0x11,0x13,0x2B,0x3F,0x54,0x4C,0x18,0x0D,0x0B,0x1F,0x23};
    TFT_Cmd(0xE0); for(int i=0;i<14;i++) TFT_Data8(gp[i]);
    uint8_t gn[] = {0xD0,0x04,0x0C,0x11,0x13,0x2C,0x3F,0x44,0x51,0x2F,0x1F,0x1F,0x20,0x23};
    TFT_Cmd(0xE1); for(int i=0;i<14;i++) TFT_Data8(gn[i]);

    // Инверсия — ВЫКЛ!
    TFT_Cmd(0x20);

    // Включение дисплея
    TFT_Cmd(0x29); HAL_Delay(20);

    // Тест: закрась чёрным
    TFT_FillScreen(BLACK);
}

